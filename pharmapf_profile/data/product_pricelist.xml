<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
    <!-- Allow updating on noupdate=True records -->
    <function name="write" model="ir.model.data">
        <value
            model="ir.model.data"
            search="[('module', '=', 'pharma_vertical'), ('name', '=', 'product_pricelist_ald')]"
        />
        <value eval="{'noupdate': False}" />
    </function>
    <function name="write" model="ir.model.data">
        <value
            model="ir.model.data"
            search="[('module', '=', 'pharma_vertical'), ('name', '=', 'product_pricelist_tp')]"
        />
        <value eval="{'noupdate': False}" />
    </function>

    <!-- We force the data update -->
    <record id="pharma_vertical.product_pricelist_ald" model="product.pricelist">
        <field name="split_invoice_partner_id" ref="pharmapf_profile.l10n_pf_cps" />
    </record>
    <record id="pharma_vertical.product_pricelist_tp" model="product.pricelist">
        <field name="split_invoice_partner_id" ref="pharmapf_profile.l10n_pf_cps" />
    </record>
    <!-- Revoke noupdate change -->
    <function name="write" model="ir.model.data">
        <value
            model="ir.model.data"
            search="[('module', '=', 'pharma_vertical'), ('name', '=', 'product_pricelist_ald')]"
        />
        <value eval="{'noupdate': True}" />
    </function>
    <function name="write" model="ir.model.data">
        <value
            model="ir.model.data"
            search="[('module', '=', 'pharma_vertical'), ('name', '=', 'product_pricelist_tp')]"
        />
        <value eval="{'noupdate': True}" />
    </function>
    <data noupdate="1">
        <record id="product_pricelist_mat" model="product.pricelist">
            <field name="name">Maternité</field>
            <field name="split_invoice_partner_id" ref="pharmapf_profile.l10n_pf_cps" />
        </record>
        <record id="product_pricelist_at" model="product.pricelist">
            <field name="name">Arrêt de Travail</field>
            <field name="split_invoice_partner_id" ref="pharmapf_profile.l10n_pf_cps" />
        </record>
        <record id="product_pricelist_cc" model="product.pricelist">
            <field name="name">Contraception</field>
            <field name="split_invoice_partner_id" ref="pharmapf_profile.l10n_pf_cps" />
        </record>
        <record id="product_pricelist_ccu" model="product.pricelist">
            <field name="name">Contraception Urgent</field>
            <field name="split_invoice_partner_id" ref="pharmapf_profile.l10n_pf_cps" />
        </record>
        <record id="product_pricelist_115" model="product.pricelist">
            <field name="name">ART 115</field>
            <field name="split_invoice_partner_id" ref="pharmapf_profile.l10n_pf_cps" />
        </record>
        <record id="product_pricelist_retr" model="product.pricelist">
            <field name="name">Retraité 100%</field>
            <field name="split_invoice_partner_id" ref="pharmapf_profile.l10n_pf_cps" />
        </record>
        <record id="product_pricelist_app" model="product.pricelist">
            <field name="name">Appareillage</field>
            <field name="split_invoice_partner_id" ref="pharmapf_profile.l10n_pf_cps" />
        </record>
    </data>
</odoo>
